---
// Demos.astro — before/after Test-Time Training
const demoSequences = [
  {
    task: 'rotate blue block right -> move slider right -> lift red block from slider -> place in slider -> turn off lightbulb',
    before: 'figures/ttt_comparison/seq1_before_ttt.gif',
    after: 'figures/ttt_comparison/seq1_after_ttt.gif',
  },
  {
    task: 'open drawer -> push red block right -> move slider left -> lift pink block from slider -> place in slider',
    before: 'figures/ttt_comparison/seq2_before_ttt.gif',
    after: 'figures/ttt_comparison/seq2_after_ttt.gif',
  },
  {
    task: 'rotate pink block right -> turn off LED -> lift pink block -> place in slider -> open drawer',
    before: 'figures/ttt_comparison/seq3_before_ttt.gif',
    after: 'figures/ttt_comparison/seq3_after_ttt.gif',
  },
];
---
<section id="demos" class="content-section">
  <div class="section-container">
    <h2 class="section-title">Test-Time Training in Action</h2>
    <p class="section-description">
      Qualitative CALVIN rollouts before and after Test-Time Training. Each pair uses the same
      task sequence, showing how world model adaptation changes the agent's behavior.
    </p>

    <div class="demo-sequences">
      {demoSequences.map((demo) => (
        <div class="demo-sequence">
          <p class="task-line">
            <span>Task:</span> {demo.task}
          </p>
          <div class="demos-grid">
            <figure class="demo-card">
              <div class="demo-tag before">Before TTT</div>
              <img src={demo.before} alt={`Rollout before Test-Time Training for task: ${demo.task}`} loading="lazy" />
            </figure>
            <figure class="demo-card">
              <div class="demo-tag after">After TTT</div>
              <img src={demo.after} alt={`Rollout after Test-Time Training for task: ${demo.task}`} loading="lazy" />
            </figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .demo-sequences {
    display: grid;
    gap: 2.25rem;
  }
  .demo-sequence {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .task-line {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
    color: var(--text-primary);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .task-line span {
    color: var(--accent-color);
    margin-right: 0.35rem;
  }
  .demos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 980px;
    margin: 0 auto;
  }
  .demo-card {
    background: #fff;
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    padding: 1.1rem;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);
    text-align: center;
  }
  .demo-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .demo-tag {
    display: inline-block;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.25rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 0.8rem;
  }
  .demo-tag.before { background: #fee2e2; color: #b91c1c; }
  .demo-tag.after { background: #dcfce7; color: #15803d; }
  @media (max-width: 768px) {
    .demos-grid { grid-template-columns: 1fr; }
  }
</style>
