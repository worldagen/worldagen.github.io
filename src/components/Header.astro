---
// src/components/Header.astro
---

<header>
  <div class="container">
      <a href="#hero" class="info-badge">
          <img src="logo/worldagen.png" alt="WorldAgen logo" class="badge-icon" />
          <span class="badge-text"><strong>WorldAgen</strong></span>
      </a>

      <div class="nav-wrapper">
          <nav class="main-nav">
              <ul>
                  <li><a href="#method">Method</a></li>
                  <li><a href="#results">Results</a></li>
                  <li><a href="#demos">Demos</a></li>
                  <li><a href="#cite">Cite</a></li>
                  <li><a href="https://github.com/mll-lab-nu/WorldAgen" target="_blank" rel="noopener noreferrer" class="github-repo">
                    <div class="repo-icon">
                        <svg aria-hidden="true" height="24" viewBox="0 0 16 16" width="24" fill="currentColor">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
                        </svg>
                    </div>
                  </a>
                  </li>
              </ul>
          </nav>
      </div>
  </div>
</header>

<style>
  header {
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--card-border);
    height: var(--header-height, 60px);
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .container {
    max-width: var(--page-max-width, 1100px);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .nav-wrapper {
      display: flex;
      align-items: center;
      width: auto;
  }

  .main-nav {
      width: 100%;
  }

  .main-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      justify-content: flex-end;
      width: 100%;
  }

  .main-nav li {
      display: inline-block;
      white-space: nowrap;
      position: relative;
  }

  .main-nav > ul > li > a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s ease;
      display: flex;
      align-items: center;
      padding: 0.5rem;
  }

  .main-nav > ul > li > a:hover,
  .main-nav > ul > li > a:focus {
      color: var(--accent-color);
  }

  .github-repo {
      display: flex;
      align-items: center;
      text-decoration: none;
      color: var(--text-secondary);
      padding: 4px;
      border-radius: 6px;
      transition: background-color 0.2s ease;
  }

  .github-repo:hover {
      background-color: rgba(99, 102, 241, 0.1);
      color: var(--accent-color);
  }

  .repo-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      color: inherit;
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 15px;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    gap: 8px;
    text-decoration: none;
    color: var(--text-primary);
    font-size: 1rem;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    min-width: 0;
    overflow: hidden;
  }

  .info-badge:hover {
    background-color: rgba(99, 102, 241, 0.1);
    border-color: var(--accent-color);
    cursor: pointer;
  }

  .badge-icon {
    height: 24px;
    width: auto;
    flex-shrink: 0;
  }

  .badge-text {
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 0.5rem;
    }

    .main-nav ul {
      gap: 0;
      justify-content: space-between;
    }

    .main-nav > ul > li > a {
      font-size: 0.85rem;
      padding: 0.25rem 0.35rem;
    }

    .info-badge {
      padding: 6px 10px;
      font-size: 0.9rem;
      max-width: 110px;
    }

    .badge-icon {
      height: 20px;
    }

    .github-repo {
      padding: 2px;
    }

    .repo-icon svg {
      height: 20px;
      width: 20px;
    }
  }

  @media (max-width: 480px) {
    .info-badge {
      padding: 4px 6px;
      max-width: 60px;
      justify-content: center;
    }

    .badge-text {
      display: none;
    }

    .badge-icon {
      height: 24px;
    }

    .main-nav > ul > li > a {
      font-size: 0.8rem;
      padding: 0.25rem;
    }
  }
</style>
